# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Batch e PowerShell com CRLF no Windows
*.bat eol=crlf
*.ps1 eol=crlf

# Arquivos Binários / Mídia / 3D (Candidatos a Git LFS se ativado no repositório)
*.blend binary
*.obj text eol=lf
*.mtl text eol=lf
*.png binary
*.jpg binary
*.wav binary
*.ogg binary
*.pdf binary
